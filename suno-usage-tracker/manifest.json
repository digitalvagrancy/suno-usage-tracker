{
  "manifest_version": 3,
  "name": "Suno Usage Tracker",
  "version": "1.3",
  "description": "Shows Suno usage (e.g. 90/100) and estimated generations left.",
  "permissions": ["storage"],
  "host_permissions": ["https://suno.com/*", "https://*.suno.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Suno usage" },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
